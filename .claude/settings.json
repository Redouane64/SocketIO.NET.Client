{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet list:*)",
      "Bash(dotnet nuget list source:*)",
      "Bash(dotnet sln list:*)",
      "Bash(dotnet --info)",
      "Bash(dotnet --list-sdks)",
      "Bash(dotnet --list-runtimes)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm run start:server)"
    ],
    "deny": [
      "Read(./**/*.pfx)",
      "Read(./**/*.snk)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(dotnet nuget push:*)",
      "Bash(npm publish:*)"
    ]
  }
}
